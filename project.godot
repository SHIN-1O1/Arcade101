; Engine configuration file.
config_version=5

[application]

config/name="Pocket Arcade"
config/description="Offline mini-games collection"
run/main_scene="res://scenes/hub.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

Save="*res://autoload/save_manager.gd"
Games="*res://autoload/game_registry.gd"
Ads="*res://autoload/ad_service.gd"
IAP="*res://autoload/iap_service.gd"
Feedback="*res://autoload/feedback.gd"
Nav="*res://autoload/nav.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
